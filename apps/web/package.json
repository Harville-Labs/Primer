{
	"name": "@primer/web",
	"version": "0.1.14",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"generate:api": "openapi-typescript ../../schemas/control.json -o src/lib/api/generated/control.ts && openapi-typescript ../../schemas/chat.json -o src/lib/api/generated/chat.ts",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.6",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@lucide/svelte": "^1.64.0",
		"@sivir-ui/svelte": "^0.4.5",
		"@tailwindcss/vite": "^4.3.3",
		"eventsource-parser": "4.1.3",
		"tailwindcss": "^4.3.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
