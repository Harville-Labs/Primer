# Copy to .env beside compose.yaml and fill in. Compose reads it automatically.
#
# This profile is single-user and has no authentication. For a deployment
# other people use, see the Kubernetes chart - that is where identity lives.
#
#   cp deploy/compose/env.example deploy/compose/.env
#
# Every variable below without a default is required: Compose refuses to
# start rather than silently using a placeholder for a credential.

# --- Credentials for the bundled dependencies -------------------------------
# Generate with: openssl rand -hex 32
#
# PostgreSQL only reads POSTGRES_PASSWORD when it initialises its data
# directory. Changing it later leaves the stored password as it was, and
# every service fails with "password authentication failed". To change it,
# discard the volume first:
#
#   docker compose -f deploy/compose/compose.yaml down -v
#
# That deletes the database, so only do it on a stack you can recreate.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Shared by Primer's own services for their cluster-internal APIs. Unset
# denies those APIs entirely, which breaks ingestion.
PRIMER_INTERNAL_API_TOKEN=

# --- Inference --------------------------------------------------------------
# Primer bundles no model. Point these at an OpenAI-compatible endpoint.
#
#   vLLM        http://host.docker.internal:8000/v1
#   Ollama      http://host.docker.internal:11434/v1
#   llama.cpp   http://host.docker.internal:8080/v1   (llama-server)
#
# On Linux, host.docker.internal needs:
#   extra_hosts: ["host.docker.internal:host-gateway"]

PRIMER_CHAT_BASE_URL=http://host.docker.internal:11434/v1
# Optional, and not how this is made to work: it only says which of the
# models your endpoint serves a new chat starts on. Left unset, Primer asks
# the endpoint what it has and starts on the first. Naming one the endpoint
# does not serve is worse than naming none - it is offered as though it were
# available and every question on it is refused.
#PRIMER_CHAT_MODEL=llama3.1:8b
PRIMER_CHAT_API_KEY=

PRIMER_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
PRIMER_EMBEDDING_MODEL=nomic-embed-text
# Must match the model. Changing it invalidates every stored vector.
PRIMER_EMBEDDING_DIMENSIONS=768
PRIMER_EMBEDDING_API_KEY=

# --- Optional ---------------------------------------------------------------
PRIMER_CONTROL_PORT=8000
PRIMER_WEB_PORT=3000
PRIMER_MAX_UPLOAD_BYTES=104857600
# The web server's own body-size cap; keep it above PRIMER_MAX_UPLOAD_BYTES
# (with headroom for multipart overhead) or uploads near the limit fail
# before Control ever gets to check them.
PRIMER_WEB_BODY_SIZE_LIMIT=115343360
# Reads text out of images and slides. Off is faster and needs no downloads.
PRIMER_ENABLE_OCR=true
# The Hugging Face tokenizer chunks are sized against, which has to be the
# embedding model's own - the id of the model, not the name your endpoint
# serves it under. Ollama's `nomic-embed-text` is `nomic-ai/nomic-embed-text-v1.5`
# upstream; `Qwen/Qwen3-Embedding-0.6B` and `BAAI/bge-m3` are already ids.
#
# Leave it empty and the worker warns on startup and splits on document
# structure alone: one chunk per text item, none of them merged, which
# stores a form or a statement one line at a time and quotes those lines
# back as citations. Empty is only right when the model is hosted and
# publishes no tokenizer; name the nearest open model in that case.
PRIMER_CHUNK_TOKENIZER=nomic-ai/nomic-embed-text-v1.5
# Ceiling per chunk. 512 is a paragraph-sized passage; raise towards 1024
# for prose, lower for dense reference material. Must fit the model's input.
PRIMER_MAX_CHUNK_TOKENS=512
PRIMER_VECTOR_STORE=pgvector

# --- Knowledge graph (optional) ---------------------------------------------
# Search also follows the entities a question names through a graph built
# from your documents, which finds passages that never use the question's
# words. Off until all three of these are set:
#
#COMPOSE_PROFILES=graph
#PRIMER_GRAPH_URL=bolt://neo4j:7687
# Generate with: openssl rand -hex 32. Like POSTGRES_PASSWORD, Neo4j reads
# it only when it first creates its data volume.
#PRIMER_GRAPH_PASSWORD=
#
# The model that reads the graph out of each passage. Any OpenAI-compatible
# endpoint with structured output; a small instruction-tuned model will do.
# Documents indexed before this was set have no graph until reindexed.
#PRIMER_GRAPH_EXTRACTION_BASE_URL=http://host.docker.internal:11434/v1
#PRIMER_GRAPH_EXTRACTION_MODEL=qwen2.5:7b-instruct
#PRIMER_GRAPH_EXTRACTION_API_KEY=
