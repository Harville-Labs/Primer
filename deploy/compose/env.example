# Copy to .env at the repository root and fill in. Compose reads it
# automatically when started from there.
#
# This profile is single-user and has no authentication. For a deployment
# other people use, see the Kubernetes chart - that is where identity lives.
#
#   cp deploy/compose/env.example .env
#
# Every variable below without a default is required: Compose refuses to
# start rather than silently using a placeholder for a credential.

# --- Credentials for the bundled dependencies -------------------------------
# Generate with: openssl rand -hex 32
#
# PostgreSQL only reads POSTGRES_PASSWORD when it initialises its data
# directory. Changing it later leaves the stored password as it was, and
# every service fails with "password authentication failed". To change it,
# discard the volume first:
#
#   docker compose down -v
#
# That deletes the database, so only do it on a stack you can recreate.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Shared by Primer's own services for their cluster-internal APIs. Unset
# denies those APIs entirely, which breaks ingestion.
PRIMER_INTERNAL_API_TOKEN=

# --- Your own PostgreSQL (optional) -----------------------------------------
# Set this to use a PostgreSQL you run instead of the bundled one, which then
# does not start and needs no POSTGRES_PASSWORD. The user needs to own the
# database: migrations create its schemas.
#
#PRIMER_DATABASE_URL=postgresql://primer:PASSWORD@db.example.internal:5432/primer

# --- Your own Qdrant (optional) ---------------------------------------------
# Set this to use a Qdrant you run instead of the bundled one, which then
# does not start. The API key is for a Qdrant that asks for one.
#
#PRIMER_QDRANT_URL=https://qdrant.example.internal:6333
#PRIMER_QDRANT_API_KEY=
# memory keeps exact vectors in RAM. disk searches a quantized copy, for a
# library too large for that; set it before the first upload.
#PRIMER_QDRANT_LAYOUT=memory

# --- Inference --------------------------------------------------------------
# Embedding and reranking work as they come: the stack runs its own servers
# for both, and downloads their models on first start (a few gigabytes). Chat is
# the one model you bring. Any OpenAI-compatible endpoint works:
#
#   vLLM        http://host.docker.internal:8000/v1
#   Ollama      http://host.docker.internal:11434/v1
#   llama.cpp   http://host.docker.internal:8080/v1   (llama-server)
#   hosted      the provider's base URL, ending in /v1, with an API key
#
# On Linux, host.docker.internal needs:
#   extra_hosts: ["host.docker.internal:host-gateway"]
#
# Left unset, add a provider on the settings page instead.
#PRIMER_CHAT_BASE_URL=http://host.docker.internal:11434/v1
# Optional, and not how this is made to work: it only says which of the
# models your endpoint serves a new chat starts on. Left unset, Primer asks
# the endpoint what it has and starts on the first. Naming one the endpoint
# does not serve is worse than naming none - it is offered as though it were
# available and every question on it is refused.
#PRIMER_CHAT_MODEL=llama3.1:8b
#PRIMER_CHAT_API_KEY=
# Whether that endpoint returns logprobs, for scoring on the Anomalies tab.
# Declared rather than detected: a server without them usually answers
# anyway with the field left out, which reads as a model never surprised.
# Prompt logprobs score text the model did not write, through echo on
# /completions; vLLM supports it, most hosted APIs do not.
#PRIMER_CHAT_SUPPORTS_LOGPROBS=true
#PRIMER_CHAT_SUPPORTS_PROMPT_LOGPROBS=true

# The embedding model. Changing it after the first upload means reindexing:
# it decides the width of every stored vector. The bundled server loads
# whatever is named here; Primer knows the width and prompts of the models
# docs/operations/models.md lists.
#PRIMER_EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
# The bundled server's pooling. last-token is right for the Qwen3 models;
# most others want mean or cls.
#PRIMER_EMBEDDING_POOLING=last-token
#
# Your own embedding server instead. Setting the URL stops the bundled one,
# and the model must be the name your server answers to. On Apple Silicon a
# native Ollama is much faster than the bundled server, which runs emulated:
#   ollama pull qwen3-embedding:0.6b
#PRIMER_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#PRIMER_EMBEDDING_MODEL=qwen3-embedding:0.6b
#PRIMER_EMBEDDING_API_KEY=
# For a model Primer does not know, say what it is. Changing the width
# invalidates every stored vector.
#PRIMER_EMBEDDING_DIMENSIONS=1024
#PRIMER_EMBEDDING_QUERY_PREFIX=
#PRIMER_EMBEDDING_DOCUMENT_PREFIX=

# The reranker re-scores the vector search's shortlist. Setting the URL stops
# the bundled one: to your own server (a TEI or vLLM /rerank, with no /v1),
# or to nothing at all to search without reranking.
#PRIMER_RERANK_BASE_URL=
#PRIMER_RERANK_MODEL=BAAI/bge-reranker-base
#PRIMER_RERANK_API_KEY=
# At most 32 with the bundled reranker.
#PRIMER_RERANK_CANDIDATES=20

# --- Optional ---------------------------------------------------------------
PRIMER_CONTROL_PORT=8000
PRIMER_WEB_PORT=3000
PRIMER_MAX_UPLOAD_BYTES=104857600
# The web server's own body-size cap; keep it above PRIMER_MAX_UPLOAD_BYTES
# (with headroom for multipart overhead) or uploads near the limit fail
# before Control ever gets to check them.
PRIMER_WEB_BODY_SIZE_LIMIT=115343360
# Reads text out of images and slides. Off is faster and needs no downloads.
PRIMER_ENABLE_OCR=true
# Where Docling runs its layout models: auto uses a GPU when the container
# has one. Threads is how many CPU cores they use; four suits most laptops.
PRIMER_PARSE_DEVICE=auto
PRIMER_PARSE_THREADS=4
# Chunks are sized with the embedding model's own tokenizer, found from
# PRIMER_EMBEDDING_MODEL. Name one here only for a hosted model that
# publishes none - the nearest open model is close enough. Without any, the
# worker warns and splits on document structure alone, which stores a form
# one line at a time.
#PRIMER_CHUNK_TOKENIZER=BAAI/bge-m3
# Ceiling per chunk. 512 is a paragraph-sized passage; raise towards 1024
# for prose, lower for dense reference material. Must fit the model's input.
PRIMER_MAX_CHUNK_TOKENS=512

# --- Knowledge graph (optional) ---------------------------------------------
# Search also follows the entities a question names through a graph built
# from your documents, which finds passages that never use the question's
# words. Off until all three of these are set:
#
#COMPOSE_PROFILES=graph
#PRIMER_GRAPH_URL=bolt://neo4j:7687
# Generate with: openssl rand -hex 32. Like POSTGRES_PASSWORD, Neo4j reads
# it only when it first creates its data volume.
#PRIMER_GRAPH_PASSWORD=
#
# The model that reads the graph out of each passage. Any OpenAI-compatible
# endpoint with structured output; a small instruction-tuned model will do.
# Documents indexed before this was set have no graph until reindexed.
#PRIMER_GRAPH_EXTRACTION_BASE_URL=http://host.docker.internal:11434/v1
#PRIMER_GRAPH_EXTRACTION_MODEL=qwen2.5:7b-instruct
#PRIMER_GRAPH_EXTRACTION_API_KEY=

# --- Lab (optional) ---------------------------------------------------------
# A tab for looking inside a small open model and editing how it runs. Off
# until its profile is on; both profiles together are COMPOSE_PROFILES=graph,lab.
# On an NVIDIA GPU, also pass -f deploy/compose/compose.gpu.yaml.
#
#COMPOSE_PROFILES=lab
# Shows the Lab section in the web app. Set it with the profile: Compose
# cannot tell Control which profiles are on.
#PRIMER_LAB_SERVICE_URL=http://lab:8000
#
# The model loaded at startup, as JSON: a Hugging Face repository, or a
# directory of your own weights inside the lab-models volume.
#PRIMER_LAB_MODEL={"source": "hub", "repository": "Qwen/Qwen3-1.7B"}
#PRIMER_LAB_MODEL={"source": "local", "path": "my-finetune"}
#
# Who may switch the model everyone's runs use: users, admins, or operator
# (only this file). Repository patterns are a JSON list, for example
# ["Qwen/*"]; the default allows any repository.
#PRIMER_LAB_MODEL_CHOICE=users
#PRIMER_LAB_REPOSITORY_PATTERNS=["*/*"]
# The largest model Lab will download, in bytes, checked before it starts.
#PRIMER_LAB_MAX_MODEL_BYTES=20000000000
# The SAEs for each model, as JSON from model repository to SAE repository.
# The default gives Qwen3-1.7B Qwen-Scope (about 15GB, research use only);
# {} turns the feature view off.
#PRIMER_LAB_SAES={"Qwen/Qwen3-1.7B": "Qwen/SAE-Res-Qwen3-1.7B-Base-W32K-L0_50"}
# Labels for SAE features, as JSON from SAE repository to a JSON Lines file
# inside the weights volume. A malformed file stops Lab starting.
#PRIMER_LAB_FEATURE_LABELS={"Qwen/SAE-Res-Qwen3-1.7B-Base-W32K-L0_50": "labels/qwen-scope.jsonl"}
# A hub mirror, for a machine that cannot reach huggingface.co.
#PRIMER_LAB_HUB_ENDPOINT=
# Days a saved experiment is kept, from when it was saved; Lab deletes it
# within the hour after that. Nothing is kept that nobody saved.
#PRIMER_LAB_EXPERIMENT_RETENTION_DAYS=90
