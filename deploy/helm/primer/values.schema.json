{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Primer Helm values",
  "description": "Validated at install time, so a wrong value fails before anything is created rather than after a pod starts.",
  "type": "object",
  "required": [
    "auth",
    "ingress",
    "postgresql",
    "rabbitmq",
    "inference",
    "vectorStore"
  ],
  "properties": {
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "oidc for any deployment other people use. disabled makes every request one fixed local user.",
          "enum": [
            "oidc",
            "disabled"
          ]
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuerUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "existingSecret": {
              "description": "A secret you manage. The chart never generates or inlines OIDC credentials.",
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string"
            },
            "cookieSecretKey": {
              "type": "string"
            },
            "emailDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scopes": {
              "type": "string"
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecret": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        },
        "bundled": {
          "type": "object",
          "description": "A PostgreSQL run by this release. existingSecret then holds its password, not a URI.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string"
        }
      }
    },
    "sourceStore": {
      "type": "object",
      "properties": {
        "url": {
          "description": "An fsspec URL. Object storage for more than one replica: a ReadWriteOnce volume cannot be shared between nodes.",
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "inference": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "models": {
              "description": "Further models on the same endpoint a user may pick between.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "existingSecret": {
              "type": "string"
            },
            "apiKeyKey": {
              "type": "string"
            },
            "historyMessages": {
              "description": "Earlier messages a follow-up question may recall.",
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "contextTokens": {
              "description": "Context window assumed for a model not named in modelContextTokens.",
              "type": "integer",
              "minimum": 1024
            },
            "modelContextTokens": {
              "description": "Context window per model name, for models that differ from contextTokens.",
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1024
              }
            },
            "replyTokens": {
              "description": "Held back out of the context window for the answer.",
              "type": "integer",
              "minimum": 64
            },
            "charactersPerToken": {
              "description": "How prompt size is estimated. Primer does not tokenize.",
              "type": "number",
              "exclusiveMinimum": 0.5,
              "maximum": 8
            },
            "compactHistory": {
              "description": "Summarize the turns that no longer fit instead of dropping them.",
              "type": "boolean"
            },
            "summaryTokens": {
              "description": "Room reserved for the summary of compacted turns.",
              "type": "integer",
              "minimum": 64,
              "maximum": 4096
            }
          }
        },
        "embeddings": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "dimensions": {
              "description": "Empty takes the width from Primer's table of known models. Changing it invalidates every stored vector.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "maxLength": 0
                }
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "apiKeyKey": {
              "type": "string"
            },
            "queryPrefix": {
              "description": "Prompt put before every query. Empty takes it from Primer's table of known models.",
              "type": "string"
            },
            "documentPrefix": {
              "description": "Prompt put before every passage. Empty takes it from Primer's table of known models.",
              "type": "string"
            }
          }
        },
        "minScore": {
          "description": "Drop passages scoring below this. Empty means no floor. The scale belongs to whatever produced the score, so measure before setting one.",
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "vectorStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "A Qdrant you run, as an http(s):// URL. Exclusive with qdrant.enabled.",
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "existingSecret": {
          "description": "A Secret holding a Qdrant API key under apiKeyKey. Optional.",
          "type": "string"
        },
        "apiKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "description": "memory keeps full-precision vectors in RAM; disk keeps them on disk and searches an int8 copy, for libraries too large for memory.",
          "type": "string",
          "enum": ["memory", "disk"]
        },
        "qdrant": {
          "type": "object",
          "description": "A Qdrant run by this release. Exclusive with url.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "description": "Optional knowledge graph in Neo4j. Off unless url is set or neo4j.enabled is true.",
      "properties": {
        "url": {
          "description": "bolt:// or neo4j:// for a Neo4j you run. Empty, with neo4j.enabled false, turns the graph off.",
          "type": "string",
          "pattern": "^$|^(bolt|neo4j)(\\+s|\\+ssc)?://"
        },
        "neo4j": {
          "type": "object",
          "description": "A Neo4j run by this release. Exclusive with url.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "heapSize": {
              "description": "Neo4j's heap, as Neo4j writes sizes: 512m, 2g.",
              "type": "string",
              "pattern": "^[0-9]+[kmg]$"
            },
            "pageCacheSize": {
              "description": "Neo4j's page cache, as Neo4j writes sizes.",
              "type": "string",
              "pattern": "^[0-9]+[kmg]$"
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "username": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "existingSecret": {
          "description": "Required when the graph is on: a Secret holding the Neo4j password.",
          "type": "string"
        },
        "passwordKey": {
          "type": "string"
        },
        "hops": {
          "description": "How far search follows relations from what a question names.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "candidates": {
          "description": "Passages the graph adds to a search before fusion.",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "extraction": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "model": {
              "description": "Must support structured output.",
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "apiKeyKey": {
              "type": "string"
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "servers": {
          "type": "array"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ingestion": {
      "type": "object",
      "properties": {
        "chunkTokenizer": {
          "description": "Hugging Face id of the tokenizer chunks are sized against. Empty lets the parse worker derive it from inference.embeddings.model.",
          "type": "string"
        },
        "maxChunkTokens": {
          "description": "Ceiling per chunk, in that tokenizer's tokens. Must stay under the embedding model's input limit.",
          "type": "integer",
          "minimum": 1
        },
        "maxPicturesPerDocument": {
          "description": "How many embedded images the parse worker runs OCR over before leaving the rest unread. 0 disables picture reading.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workers": {
      "type": "object",
      "properties": {
        "parse": {
          "type": "object",
          "required": [
            "concurrency"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "concurrency": {
              "description": "Processes per pod. Absent, Celery sizes its pool from the node's CPU count, which is not what the memory limit was set for.",
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "modelCache": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessMode": {
                  "description": "Empty follows workers.parse.replicas: one replica gets ReadWriteOnce, more than one ReadWriteMany. Set only to overrule that.",
                  "type": "string",
                  "enum": [
                    "",
                    "ReadWriteOnce",
                    "ReadWriteMany"
                  ]
                }
              }
            }
          }
        },
        "index": {
          "type": "object",
          "required": [
            "concurrency"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "concurrency": {
              "description": "Processes per pod. Absent, Celery sizes its pool from the node's CPU count, which is not what the memory limit was set for.",
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        }
      }
    },
    "extraEnv": {
      "description": "Extra environment variables added to every Primer workload. An escape hatch for settings this chart does not model.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccounts": {
      "type": "object",
      "properties": {
        "create": {
          "description": "One ServiceAccount per component instead of the namespace default. None is granted anything and no token is mounted.",
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "perComponent": {
          "description": "Annotations by component (control, chat, retrieval, web, auth, migrate, worker-*), merged over the shared ones. Usually cloud IAM.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Restrict which pods may reach Primer. Does nothing on a cluster whose CNI does not enforce NetworkPolicy.",
          "type": "boolean"
        },
        "ingress": {
          "description": "Peers allowed to reach the public entry point. Empty means any namespace, because the ingress controller's namespace is not known here.",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extra": {
          "description": "Whole NetworkPolicy objects, for a path this chart does not model.",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podDisruptionBudgets": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Written only for components running more than one replica: a budget on a single-replica component makes it unevictable.",
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "description": "0 leaves the metric off. Memory is a poor scaling signal for a Python service.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "control": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "description": "0 leaves the metric off. Memory is a poor scaling signal for a Python service.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "chat": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "description": "0 leaves the metric off. Memory is a poor scaling signal for a Python service.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "description": "0 leaves the metric off. Memory is a poor scaling signal for a Python service.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "web": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "description": "0 leaves the metric off. Memory is a poor scaling signal for a Python service.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
