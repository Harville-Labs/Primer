# The SvelteKit front end, built once and served by the Node adapter.
FROM node:24-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

COPY apps/web/ apps/web/
RUN pnpm --filter @primer/web build \
    && pnpm --filter @primer/web --prod --legacy deploy /app/bundle


FROM node:24-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="Primer Web" \
      org.opencontainers.image.source="https://github.com/Harville-Labs/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV NODE_ENV=production

# The base image is rebuilt less often than Debian publishes security
# fixes, so the image takes them itself rather than waiting for it.
#
# The server runs on node alone. npm, corepack and yarn come with the base
# image, are never run here, and bring their own dependencies for the scan
# to find.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
        /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*

WORKDIR /app

COPY --from=build --chown=node:node /app/apps/web/build ./build
COPY --from=build --chown=node:node /app/bundle/node_modules ./node_modules

USER node

EXPOSE 3000
CMD ["node", "build/index.js"]
