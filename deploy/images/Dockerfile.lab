# Lab: loads a small open model and lets a user look inside it.
#
# Two targets, built from one set of locked dependencies:
#
#   docker build -f deploy/images/Dockerfile.lab --target cpu .
#   docker build -f deploy/images/Dockerfile.lab --target cuda .
#
# `cpu` is the default, because it is the last stage. Weights are not baked
# in: they are fetched into /models when a model is chosen, and that volume
# is the only place this container writes besides /tmp.

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

LABEL org.opencontainers.image.title="Primer Lab" \
      org.opencontainers.image.description="Inspects and edits a small open model as it runs" \
      org.opencontainers.image.source="https://github.com/isaiah-harville/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

# HF_HOME is pointed at the weights volume so that anything transformers
# caches beside the model - not only the files Lab fetches itself - lands
# somewhere writable on a read-only root, and survives a restart.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1

RUN groupadd --gid 10001 primer \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin primer

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY services/control-api/pyproject.toml services/control-api/
COPY services/retrieval/pyproject.toml services/retrieval/
COPY services/chat/pyproject.toml services/chat/
COPY services/ingestion/pyproject.toml services/ingestion/
COPY packages/ packages/
COPY services/lab/ services/lab/
# nnsight publishes no Linux arm64 wheel, so on an arm64 machine - Apple
# Silicon building for Compose, say - it compiles a small C extension. The
# compiler is removed in the same layer, so it never reaches the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && uv sync --locked --group server --package primer-lab \
    && apt-get purge -y --auto-remove gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /models \
    && chown -R 10001:10001 /app /models

EXPOSE 8000
CMD ["uvicorn", "primer_lab.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

# The lockfile resolves torch from PyTorch's CPU index on Linux, because the
# worker parses on CPU and a CUDA build would add gigabytes it never uses.
# Lab on a GPU needs the CUDA build of the same version, and a second lock
# for one image would be a second set of versions to keep in step. So this
# stage replaces only torch, at exactly the version the lock chose, and
# leaves every other package as locked.
FROM base AS cuda
RUN --mount=type=cache,target=/root/.cache/uv \
    version="$(python -c 'import importlib.metadata as m; print(m.version("torch").split("+")[0])')" \
    && uv pip install --python /app/.venv --reinstall-package torch \
         --index https://download.pytorch.org/whl/cu132 "torch==${version}" \
    && chown -R 10001:10001 /app
USER 10001:10001

FROM base AS cpu
USER 10001:10001
