# The ingestion worker

# Both stages start here, so the virtualenv is built against exactly the
# interpreter that runs it.
FROM python:3.13-slim-bookworm AS python

# The image's pip is never used - uv installs everything - and it carries
# its own vendored copies of urllib3, msgpack and setuptools, which the
# image scan reports and nothing here would ever update.
RUN python -m pip uninstall --yes --root-user-action ignore pip


FROM python AS build

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY services/control-api/pyproject.toml services/control-api/
COPY services/retrieval/pyproject.toml services/retrieval/
COPY services/chat/pyproject.toml services/chat/
COPY services/lab/pyproject.toml services/lab/
COPY packages/ packages/
COPY services/ingestion/ services/ingestion/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --package primer-ingestion


# Only the virtualenv and the workspace it points at, owned by root: the
# worker reads its code and never writes it. The one place it writes is the
# Hugging Face cache, which is a volume mounted over the directory made here.
FROM python

LABEL org.opencontainers.image.title="Primer Ingestion Worker" \
      org.opencontainers.image.description="Parses, chunks, and indexes documents" \
      org.opencontainers.image.source="https://github.com/Harville-Labs/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV HAYSTACK_TELEMETRY_ENABLED=False \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/var/cache/primer/huggingface

# The base image is rebuilt less often than Debian publishes security
# fixes, so the image takes them itself rather than waiting for it. The
# libraries are what OpenCV, under the OCR engine, loads.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libxcb1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 primer \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin primer \
    && mkdir -p /var/cache/primer/huggingface \
    && chown 10001:10001 /var/cache/primer/huggingface

WORKDIR /app
COPY --from=build /app /app

# Fails the build, rather than the first document, if the OCR engine cannot
# load with the libraries above.
RUN python -c "from rapidocr import RapidOCR; RapidOCR()"

USER 10001:10001
CMD ["celery", "-A", "primer_ingestion.worker", "worker", "--loglevel", "info"]
