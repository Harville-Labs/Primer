{
	"name": "primer",
	"private": true,
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome ci .",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"test": "pnpm -r --if-present test",
		"generate:api": "pnpm --filter @primer/web generate:api"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15"
	}
}
