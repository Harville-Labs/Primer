{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "description": "A question, and the library it is asked of, if any.\n\nWithout a library the question is answered by the model rather than from\nthe user's documents, and the answer carries no citations.",
        "properties": {
          "breadth": {
            "default": "focused",
            "enum": [
              "focused",
              "library"
            ],
            "title": "Breadth",
            "type": "string"
          },
          "library_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Library Id"
          },
          "message": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "ChatModel": {
        "additionalProperties": false,
        "description": "One model a user may pick between.\n\nNamed separately from the provider's own listing: an endpoint serves what\nit serves, and this is the subset an operator decided to offer.",
        "properties": {
          "default": {
            "default": false,
            "title": "Default",
            "type": "boolean"
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "provider_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          },
          "provider_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Name"
          }
        },
        "required": [
          "id"
        ],
        "title": "ChatModel",
        "type": "object"
      },
      "ChatModelList": {
        "additionalProperties": false,
        "description": "What this deployment can answer with, and whether it could be asked.\n\nAn empty list with `endpoint_reachable` false is not the same fact as an\nempty list with it true, and the difference is the whole point of the\nfield. Primer used to answer an unreachable endpoint with its configured\ndefault name, which put a model in the picker that nothing was serving:\nthe interface offered a choice that did not exist and the failure only\nsurfaced when someone asked a question and waited for an answer that was\nnever coming.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "endpoint_reachable": {
            "default": true,
            "title": "Endpoint Reachable",
            "type": "boolean"
          },
          "models": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ChatModel"
            },
            "title": "Models",
            "type": "array"
          },
          "unreachable": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unreachable",
            "type": "array"
          }
        },
        "title": "ChatModelList",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "A grounded reference from an assistant response to a source passage.\n\nCitations address an immutable document version so a later replacement\ncannot silently change what an existing answer claimed to cite.",
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "excerpt": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          },
          "locator": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceLocator"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "document_id",
          "document_version_id",
          "chunk_id"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ConversationSummary": {
        "additionalProperties": false,
        "description": "A conversation, which belongs to one person and at most one library.\n\nA conversation with no library is ungrounded for its whole length: the\nlibrary is fixed when it starts, so citations in one turn and none in the\nnext cannot happen within a single thread.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "library_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Library Id"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "FollowUpRequest": {
        "additionalProperties": false,
        "properties": {
          "breadth": {
            "default": "focused",
            "enum": [
              "focused",
              "library"
            ],
            "title": "Breadth",
            "type": "string"
          },
          "message": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "FollowUpRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageRole": {
        "enum": [
          "user",
          "assistant"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "MessageState": {
        "description": "A message is always in exactly one of these.\n\n`STREAMING` is the only non-terminal state. A message left in it is a\nstream that died, which is a recoverable fault rather than an answer, and\nis distinguishable from one that genuinely failed.",
        "enum": [
          "streaming",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "MessageState",
        "type": "string"
      },
      "MessageSummary": {
        "additionalProperties": false,
        "description": "One turn, and what it was grounded in.\n\nCitations are stored with the message rather than recomputed, because\nwhat an answer cited is a fact about that answer. Re-retrieving later\nwould produce today's passages for yesterday's words.\n\nContent keeps its whitespace, like `MessageDelta`, so that concatenating\na stream's fragments yields exactly the stored answer. Trimming here\nwould make the two disagree for any answer that begins or ends with\nspace, and a client comparing them would be right to think it had lost\nsomething.",
        "properties": {
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "provider_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          },
          "provider_model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Model"
          },
          "reasoning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "state": {
            "$ref": "#/components/schemas/MessageState"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "role",
          "state",
          "content",
          "created_at"
        ],
        "title": "MessageSummary",
        "type": "object"
      },
      "ProviderCheck": {
        "additionalProperties": false,
        "description": "What happened when Primer asked a provider what it serves.\n\nRun on demand from the settings page, because the useful moment to learn\nthat a URL is wrong is while it is still on screen being typed.",
        "properties": {
          "detail": {
            "maxLength": 500,
            "title": "Detail",
            "type": "string"
          },
          "models": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "detail"
        ],
        "title": "ProviderCheck",
        "type": "object"
      },
      "ProviderCreate": {
        "additionalProperties": false,
        "description": "A provider being added through the settings page.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Base Url",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "base_url"
        ],
        "title": "ProviderCreate",
        "type": "object"
      },
      "ProviderSummary": {
        "additionalProperties": false,
        "description": "One endpoint Primer can ask, as an administrator sees it.",
        "properties": {
          "api_key_set": {
            "default": false,
            "title": "Api Key Set",
            "type": "boolean"
          },
          "base_url": {
            "title": "Base Url",
            "type": "string"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source": {
            "default": "configured",
            "enum": [
              "deployment",
              "configured"
            ],
            "title": "Source",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "name",
          "base_url"
        ],
        "title": "ProviderSummary",
        "type": "object"
      },
      "ProviderUpdate": {
        "additionalProperties": false,
        "description": "A change to a provider. Absent fields are left alone.\n\n`api_key` has three states rather than two, which is why it is not a\nplain optional string: absent leaves the stored key untouched, a string\nreplaces it, and an empty string removes it. Without the third, a key\ncould be set and never unset.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "ProviderUpdate",
        "type": "object"
      },
      "SourceLocator": {
        "additionalProperties": false,
        "description": "Where a passage sits inside its source document.\n\nLocators are user-meaningful positions only. Filesystem or object-store\npaths are deliberately absent from citation-facing contracts.",
        "properties": {
          "page": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "section": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          }
        },
        "title": "SourceLocator",
        "type": "object"
      },
      "ToolCallSummary": {
        "additionalProperties": false,
        "description": "One tool call, and what was decided about it.\n\nArguments are shown to the user because they are what is being consented\nto: approving \"run a command\" without seeing the command is not consent.\nThey are sanitized before they get here.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "duration_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_code": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "maxLength": 8000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "phase": {
            "$ref": "#/components/schemas/ToolPhase"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "server_name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Server Name",
            "type": "string"
          },
          "tool_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "tool_name",
          "server_name",
          "phase",
          "requested_at",
          "expires_at"
        ],
        "title": "ToolCallSummary",
        "type": "object"
      },
      "ToolPhase": {
        "description": "The stages a tool call passes through, as a client sees them.",
        "enum": [
          "requested",
          "approved",
          "denied",
          "running",
          "completed",
          "failed",
          "expired"
        ],
        "title": "ToolPhase",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Cited, streamed answers grounded in a user's own library",
    "title": "Primer Chat",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/providers": {
      "get": {
        "operationId": "list_providers_api_v1_admin_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderSummary"
                  },
                  "title": "Response List Providers Api V1 Admin Providers Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Every endpoint this deployment can ask",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "operationId": "add_provider_api_v1_admin_providers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add an endpoint",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/providers/{provider_id}": {
      "delete": {
        "operationId": "delete_provider_api_v1_admin_providers__provider_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove an endpoint",
        "tags": [
          "admin"
        ]
      },
      "patch": {
        "operationId": "update_provider_api_v1_admin_providers__provider_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change an endpoint",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/providers/{provider_id}/check": {
      "post": {
        "description": "Try the endpoint now, and report what came back.\n\nOn demand rather than on a schedule, because the useful moment to learn\nthat a URL is wrong is while it is still on screen being typed.",
        "operationId": "check_provider_api_v1_admin_providers__provider_id__check_post",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderCheck"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
