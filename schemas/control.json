{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "additionalProperties": false,
        "description": "One thing this deployment talks to.",
        "properties": {
          "detail": {
            "maxLength": 500,
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "reachable": {
            "title": "Reachable",
            "type": "boolean"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "name",
          "reachable",
          "detail"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "DeploymentCapabilities": {
        "additionalProperties": false,
        "description": "What this deployment can actually do, as the browser needs to know it.\n\nSent to the web app so it can hide what will not work rather than\noffering it and failing. Every field is a checked fact or an operator's\ndeclaration - none is inferred from a model's name.",
        "properties": {
          "auth_enabled": {
            "title": "Auth Enabled",
            "type": "boolean"
          },
          "chat_available": {
            "title": "Chat Available",
            "type": "boolean"
          },
          "ingestion_available": {
            "title": "Ingestion Available",
            "type": "boolean"
          },
          "is_admin": {
            "default": false,
            "title": "Is Admin",
            "type": "boolean"
          },
          "lab_available": {
            "default": false,
            "title": "Lab Available",
            "type": "boolean"
          },
          "max_upload_bytes": {
            "minimum": 0.0,
            "title": "Max Upload Bytes",
            "type": "integer"
          },
          "supported_extensions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Supported Extensions",
            "type": "array"
          },
          "tools_available": {
            "title": "Tools Available",
            "type": "boolean"
          }
        },
        "required": [
          "auth_enabled",
          "ingestion_available",
          "chat_available",
          "tools_available",
          "max_upload_bytes"
        ],
        "title": "DeploymentCapabilities",
        "type": "object"
      },
      "DeploymentStatus": {
        "additionalProperties": false,
        "description": "The deployment's own wiring, and how much of it is answering.",
        "properties": {
          "admin_group": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Admin Group"
          },
          "auth_mode": {
            "maxLength": 32,
            "title": "Auth Mode",
            "type": "string"
          },
          "dependencies": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          }
        },
        "required": [
          "auth_mode"
        ],
        "title": "DeploymentStatus",
        "type": "object"
      },
      "DocumentSummary": {
        "additionalProperties": false,
        "description": "A document and the state of its current immutable version.",
        "properties": {
          "byte_size": {
            "minimum": 0.0,
            "title": "Byte Size",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current_version_id": {
            "format": "uuid",
            "title": "Current Version Id",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "library_id": {
            "format": "uuid",
            "title": "Library Id",
            "type": "string"
          },
          "media_type": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/IngestionStatus"
          },
          "status_detail": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Detail"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "library_id",
          "current_version_id",
          "filename",
          "media_type",
          "byte_size",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "DocumentSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestionStatus": {
        "description": "Deterministic states a user can observe for a document version.",
        "enum": [
          "queued",
          "parsing",
          "chunking",
          "embedding",
          "indexing",
          "ready",
          "failed",
          "unsupported",
          "cancelled",
          "deleting",
          "deleted"
        ],
        "title": "IngestionStatus",
        "type": "string"
      },
      "LibraryCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "LibraryCreate",
        "type": "object"
      },
      "LibraryDuplicate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "LibraryDuplicate",
        "type": "object"
      },
      "LibraryShare": {
        "additionalProperties": false,
        "description": "One person a library has been shared with.\n\nIdentified by email as well as by id, because an id is not something the\nowner can check their intent against. Sharing is a decision about a\nperson, and the owner has to be able to see that the person on the list\nis the one they meant.\n\nDeliberately carries no role. Read access is the only thing a share\ngrants today, and a field named `role` that always says the same word\nwould be a promise the authorization model does not keep.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 320,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "created_at"
        ],
        "title": "LibraryShare",
        "type": "object"
      },
      "LibraryShareCreate": {
        "additionalProperties": false,
        "description": "Who to share with, named the way the owner knows them.",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "LibraryShareCreate",
        "type": "object"
      },
      "LibrarySummary": {
        "additionalProperties": false,
        "description": "A library as returned by the Control API.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "document_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Document Count",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner_user_id",
          "created_at",
          "updated_at"
        ],
        "title": "LibrarySummary",
        "type": "object"
      },
      "LibraryUpdate": {
        "additionalProperties": false,
        "properties": {
          "expected_updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Updated At"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "LibraryUpdate",
        "type": "object"
      },
      "Principal": {
        "additionalProperties": false,
        "description": "An authenticated Primer identity acting on a request.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 320,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "groups": {
            "default": [],
            "description": "Operator-policy groups; never an implicit grant to resources",
            "items": {
              "type": "string"
            },
            "title": "Groups",
            "type": "array"
          },
          "subject": {
            "description": "Stable OIDC `sub` claim",
            "maxLength": 255,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "user_id": {
            "description": "Primer-internal user identifier",
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "user_id"
        ],
        "title": "Principal",
        "type": "object"
      },
      "ReindexSummary": {
        "additionalProperties": false,
        "description": "What a library-wide rebuild actually started.\n\nTwo numbers rather than one, because they differ for a reason worth\nshowing. A document already being rebuilt is not restarted - two\nworkers writing different generations of one version, only one of which\nis ever activated - so pressing the button twice queues nothing the\nsecond time. Reporting only \"queued\" would make that look like a\nfailure.",
        "properties": {
          "queued": {
            "description": "Documents whose rebuild was started by this request",
            "title": "Queued",
            "type": "integer"
          },
          "skipped": {
            "description": "Documents already being rebuilt, left alone",
            "title": "Skipped",
            "type": "integer"
          }
        },
        "required": [
          "queued",
          "skipped"
        ],
        "title": "ReindexSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Public domain operations and authorization for Primer",
    "title": "Primer Control API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/status": {
      "get": {
        "description": "Every configured connection, and whether it is currently answering.\n\nControl's own dependencies are asked through the same registry the\nreadiness probe uses, so this page and Kubernetes cannot disagree about\nwhether the database is up. The other services are probed over HTTP,\nwhich is the only way one process learns about another.",
        "operationId": "deployment_status_api_v1_admin_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this deployment is wired to",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "description": "Report the deployment's shape.\n\nAuthenticated, because the answer describes a specific deployment's\nconfiguration and there is no reason for it to be readable by anyone who\ncannot already use it.\n\nChat, Lab and tool availability are reported by Control rather than probed\nhere: Control does not hold the inference configuration, and asking Chat\non every page load would make a browser refresh depend on a model\nendpoint being awake.",
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentCapabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What this deployment supports",
        "tags": [
          "capabilities"
        ]
      }
    },
    "/api/v1/libraries": {
      "get": {
        "operationId": "list_libraries_api_v1_libraries_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LibrarySummary"
                  },
                  "title": "Response List Libraries Api V1 Libraries Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the caller's libraries",
        "tags": [
          "libraries"
        ]
      },
      "post": {
        "operationId": "create_library_api_v1_libraries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a private library",
        "tags": [
          "libraries"
        ]
      }
    },
    "/api/v1/libraries/{library_id}": {
      "delete": {
        "operationId": "delete_library_api_v1_libraries__library_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a library",
        "tags": [
          "libraries"
        ]
      },
      "get": {
        "operationId": "read_library_api_v1_libraries__library_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read one library",
        "tags": [
          "libraries"
        ]
      },
      "patch": {
        "operationId": "rename_library_api_v1_libraries__library_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rename a library",
        "tags": [
          "libraries"
        ]
      }
    },
    "/api/v1/libraries/{library_id}/documents": {
      "get": {
        "operationId": "list_documents_api_v1_libraries__library_id__documents_get",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  },
                  "title": "Response List Documents Api V1 Libraries  Library Id  Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List a library's documents",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "operationId": "upload_document_api_v1_libraries__library_id__documents_post",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "contentMediaType": "application/octet-stream",
                    "description": "The source file to ingest",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload a document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/libraries/{library_id}/documents/reindex": {
      "post": {
        "description": "Rebuild the whole library, one job per document.\n\nThis exists because the reason to reindex is almost never one document.\nChunking, the embedding model or the tokenizer changes and everything\nindexed under the old settings is stale together; doing that a document\nat a time means clicking once per row and having no idea which rows\nwere missed.\n\nA literal path segment beside `/{document_id}`, which is unambiguous\nonly because nothing else answers POST on a single segment here. A\nfuture `POST /{document_id}` would have to be declared after this one\nor it would swallow it.\n\nPer-document refusals are not errors. `start_reindex` declines a\ndocument already being rebuilt, and on a library-wide press that is the\nordinary case rather than a fault, so it is counted and reported rather\nthan raised.",
        "operationId": "reindex_library_api_v1_libraries__library_id__documents_reindex_post",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReindexSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rebuild every document in a library",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/v1/libraries/{library_id}/documents/{document_id}": {
      "delete": {
        "description": "Tombstone first; the passages and bytes go afterwards.\n\nThe tombstone is the deletion the user asked for, and it takes effect\nimmediately. Everything after it is cleanup, and scheduling it separately\nmeans a slow or failing cleanup never leaves a deleted document\nanswering questions in the meantime.",
        "operationId": "delete_document_api_v1_libraries__library_id__documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a document",
        "tags": [
