    "/api/v1/libraries/{library_id}/duplicate": {
      "post": {
        "description": "Copy a library so the two can diverge.\n\nThe copy is owned by whoever asked for it, not by whoever owned the\noriginal: a copy of something you were allowed to read is yours, and\nleaving it owned by someone else would make it unmanageable by the only\nperson who knows it exists.\n\nIts documents are queued for indexing like any upload, so the copy is\nbrowsable immediately and answerable once they finish. Nothing is\npublished to the broker until the transaction commits.",
        "operationId": "duplicate_library_api_v1_libraries__library_id__duplicate_post",
        "parameters": [
          {
            "in": "path",
            "name": "library_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Library Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryDuplicate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Copy a library into a new one",
        "tags": [
          "libraries"
        ]
      }
    },
