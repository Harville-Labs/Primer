{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HubModel": {
        "additionalProperties": false,
        "description": "A model on the Hugging Face hub, or the operator's mirror of it.",
        "properties": {
          "repository": {
            "examples": [
              "Qwen/Qwen3-4B"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "title": "Repository",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Branch, tag, or commit; the repository's default branch when unset",
            "title": "Revision"
          },
          "source": {
            "const": "hub",
            "default": "hub",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "repository"
        ],
        "title": "HubModel",
        "type": "object"
      },
      "LabModelStatus": {
        "additionalProperties": false,
        "description": "The resident model, as a user choosing what to inspect needs it.",
        "properties": {
          "architecture": {
            "title": "Architecture",
            "type": "string"
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit"
          },
          "device": {
            "enum": [
              "cpu",
              "cuda"
            ],
            "title": "Device",
            "type": "string"
          },
          "dtype": {
            "title": "Dtype",
            "type": "string"
          },
          "num_layers": {
            "minimum": 1.0,
            "title": "Num Layers",
            "type": "integer"
          },
          "reference": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Reference"
          }
        },
        "required": [
          "reference",
          "architecture",
          "device",
          "dtype",
          "num_layers"
        ],
        "title": "LabModelStatus",
        "type": "object"
      },
      "LabStatus": {
        "additionalProperties": false,
        "properties": {
          "can_choose_model": {
            "title": "Can Choose Model",
            "type": "boolean"
          },
          "max_model_bytes": {
            "minimum": 1.0,
            "title": "Max Model Bytes",
            "type": "integer"
          },
          "max_new_tokens": {
            "minimum": 1.0,
            "title": "Max New Tokens",
            "type": "integer"
          },
          "max_prompt_tokens": {
            "minimum": 1.0,
            "title": "Max Prompt Tokens",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LabModelStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "queue_depth": {
            "minimum": 0.0,
            "title": "Queue Depth",
            "type": "integer"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "switch": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelSwitch"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ready",
          "model",
          "switch",
          "can_choose_model",
          "max_model_bytes",
          "queue_depth",
          "max_prompt_tokens",
          "max_new_tokens"
        ],
        "title": "LabStatus",
        "type": "object"
      },
      "LoadModelRequest": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "model"
        ],
        "title": "LoadModelRequest",
        "type": "object"
      },
      "LocalModel": {
        "additionalProperties": false,
        "description": "A directory the operator placed in Lab's weights volume.",
        "properties": {
          "path": {
            "description": "Relative to the weights volume; it cannot leave it",
            "examples": [
              "my-finetune"
            ],
            "maxLength": 255,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "source": {
            "const": "local",
            "default": "local",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "LocalModel",
        "type": "object"
      },
      "ModelSwitch": {
        "additionalProperties": false,
        "description": "A change of model that has been asked for and has not finished.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "reference": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Reference"
          },
          "state": {
            "enum": [
              "fetching",
              "loading",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "state"
        ],
        "title": "ModelSwitch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Look inside an open model and edit how it runs",
    "title": "Primer Lab",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/lab/model": {
      "put": {
        "description": "Starts fetching and loading the named model, and answers once that has started. The switch replaces the model for every user of this Lab; poll the status to see it finish. Naming the model already resident, or already being switched to, changes nothing.",
        "operationId": "choose_model_api_v1_lab_model_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadModelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Switch the resident model",
        "tags": [
          "lab"
        ]
      }
    },
    "/api/v1/lab/status": {
      "get": {
        "operationId": "lab_status_api_v1_lab_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The resident model and any switch in progress",
        "tags": [
          "lab"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process liveness"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Ready to answer, whether or not a model is resident yet.\n\nGating this on the model looks right and is a trap: an unready pod\nis taken out of its Service, so after a failed load nobody could\nreach Lab to choose a model that works. Whether runs can be made is\nthe status route's `ready`, which the web app reads.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
