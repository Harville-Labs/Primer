{
  "components": {
    "schemas": {
      "ActivationRequest": {
        "additionalProperties": false,
        "properties": {
          "chat": {
            "default": true,
            "title": "Chat",
            "type": "boolean"
          },
          "layer": {
            "minimum": 0.0,
            "title": "Layer",
            "type": "integer"
          },
          "prompt": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "site": {
            "enum": [
              "resid_post",
              "mlp_neuron",
              "mlp_out",
              "attn_out"
            ],
            "title": "Site",
            "type": "string"
          },
          "token": {
            "description": "Position in the inspected tokens",
            "minimum": 0.0,
            "title": "Token",
            "type": "integer"
          }
        },
        "required": [
          "prompt",
          "layer",
          "token",
          "site"
        ],
        "title": "ActivationRequest",
        "type": "object"
      },
      "ActivationVector": {
        "additionalProperties": false,
        "properties": {
          "layer": {
            "title": "Layer",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/LabModelStatus"
          },
          "site": {
            "enum": [
              "resid_post",
              "mlp_neuron",
              "mlp_out",
              "attn_out"
            ],
            "title": "Site",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "integer"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "model",
          "layer",
          "token",
          "site",
          "values"
        ],
        "title": "ActivationVector",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HubModel": {
        "additionalProperties": false,
        "description": "A model on the Hugging Face hub, or the operator's mirror of it.",
        "properties": {
          "repository": {
            "examples": [
              "Qwen/Qwen3-4B"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "title": "Repository",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Branch, tag, or commit; the repository's default branch when unset",
            "title": "Revision"
          },
          "source": {
            "const": "hub",
            "default": "hub",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "repository"
        ],
        "title": "HubModel",
        "type": "object"
      },
      "InspectRequest": {
        "additionalProperties": false,
        "properties": {
          "chat": {
            "default": true,
            "title": "Chat",
            "type": "boolean"
          },
          "neurons": {
            "default": 8,
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Neurons",
            "type": "integer"
          },
          "prompt": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "InspectRequest",
        "type": "object"
      },
      "InspectResponse": {
        "additionalProperties": false,
        "description": "What a prompt does inside the resident model.\n\nBounded by its shape: num_layers x tokens x (LENS_TOP + neurons) values,\nwith tokens at most the deployment's max_prompt_tokens and neurons at\nmost MAX_NEURONS.",
        "properties": {
          "chat_template": {
            "description": "Whether the chat template was applied",
            "title": "Chat Template",
            "type": "boolean"
          },
          "hidden_size": {
            "minimum": 1.0,
            "title": "Hidden Size",
            "type": "integer"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/LayerReadings"
            },
            "title": "Layers",
            "type": "array"
          },
          "mlp_width": {
            "minimum": 1.0,
            "title": "Mlp Width",
            "type": "integer"
          },
          "model": {
            "$ref": "#/components/schemas/LabModelStatus"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/InspectedToken"
            },
            "title": "Tokens",
            "type": "array"
          },
          "vocabulary": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Vocabulary",
            "type": "object"
          }
        },
        "required": [
          "model",
          "chat_template",
          "tokens",
          "vocabulary",
          "hidden_size",
          "mlp_width",
          "layers"
        ],
        "title": "InspectResponse",
        "type": "object"
      },
      "InspectedToken": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "special": {
            "title": "Special",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "special"
        ],
        "title": "InspectedToken",
        "type": "object"
      },
      "LabModelStatus": {
        "additionalProperties": false,
        "description": "The resident model, as a user choosing what to inspect needs it.",
        "properties": {
          "architecture": {
            "title": "Architecture",
            "type": "string"
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit"
          },
          "device": {
            "enum": [
              "cpu",
              "cuda"
            ],
            "title": "Device",
            "type": "string"
          },
          "dtype": {
            "title": "Dtype",
            "type": "string"
          },
          "num_layers": {
            "minimum": 1.0,
            "title": "Num Layers",
            "type": "integer"
          },
          "reference": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Reference"
          }
        },
        "required": [
          "reference",
          "architecture",
          "device",
          "dtype",
          "num_layers"
        ],
        "title": "LabModelStatus",
        "type": "object"
      },
      "LabStatus": {
        "additionalProperties": false,
        "properties": {
          "can_choose_model": {
            "title": "Can Choose Model",
            "type": "boolean"
          },
          "max_model_bytes": {
            "minimum": 1.0,
            "title": "Max Model Bytes",
            "type": "integer"
          },
          "max_new_tokens": {
            "minimum": 1.0,
            "title": "Max New Tokens",
            "type": "integer"
          },
          "max_prompt_tokens": {
            "minimum": 1.0,
            "title": "Max Prompt Tokens",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LabModelStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "queue_depth": {
            "minimum": 0.0,
            "title": "Queue Depth",
            "type": "integer"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "switch": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelSwitch"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ready",
          "model",
          "switch",
          "can_choose_model",
          "max_model_bytes",
          "queue_depth",
          "max_prompt_tokens",
          "max_new_tokens"
        ],
        "title": "LabStatus",
        "type": "object"
      },
      "LayerReadings": {
        "additionalProperties": false,
        "description": "One layer's summary at every position, as parallel arrays.\n\nIndexed by token position first. Columns rather than an object per\nposition, because a full-length prompt on a 36-layer model is about\neighteen thousand of them, and naming every field in every one roughly\ndoubles a response that is already the largest Lab sends.",
        "properties": {
          "lens_probabilities": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Lens Probabilities",
            "type": "array"
          },
          "lens_tokens": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Lens Tokens",
            "type": "array"
          },
          "neuron_activations": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Neuron Activations",
            "type": "array"
          },
          "neuron_indices": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Neuron Indices",
            "type": "array"
          },
          "residual_norm": {
            "items": {
              "type": "number"
            },
            "title": "Residual Norm",
            "type": "array"
          }
        },
        "required": [
          "residual_norm",
          "lens_tokens",
          "lens_probabilities",
          "neuron_indices",
          "neuron_activations"
        ],
        "title": "LayerReadings",
        "type": "object"
      },
      "LoadModelRequest": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "model"
        ],
        "title": "LoadModelRequest",
        "type": "object"
      },
      "LocalModel": {
        "additionalProperties": false,
        "description": "A directory the operator placed in Lab's weights volume.",
        "properties": {
          "path": {
            "description": "Relative to the weights volume; it cannot leave it",
            "examples": [
              "my-finetune"
            ],
            "maxLength": 255,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "source": {
            "const": "local",
            "default": "local",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "LocalModel",
        "type": "object"
      },
      "ModelSwitch": {
        "additionalProperties": false,
        "description": "A change of model that has been asked for and has not finished.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "reference": {
            "discriminator": {
              "mapping": {
                "hub": "#/components/schemas/HubModel",
                "local": "#/components/schemas/LocalModel"
              },
              "propertyName": "source"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/HubModel"
              },
              {
                "$ref": "#/components/schemas/LocalModel"
              }
            ],
            "title": "Reference"
          },
          "state": {
            "enum": [
              "fetching",
              "loading",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "state"
        ],
        "title": "ModelSwitch",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Look inside an open model and edit how it runs",
    "title": "Primer Lab",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/lab/activation": {
      "post": {
        "description": "The full vector at one site, layer and position of a prompt. A POST rather than a GET so the prompt travels in the body, not in a URL that proxies and logs keep.",
        "operationId": "activation_api_v1_lab_activation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationVector"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read one whole activation vector",
        "tags": [
          "lab"
        ]
      }
    },
    "/api/v1/lab/inspect": {
      "post": {
        "description": "Runs the prompt through the resident model once and returns, for every layer and position, the residual stream's norm, the logit lens's likeliest tokens, and the MLP neurons with the largest activations. Summaries, not raw activations: read one whole vector with the activation route.",
        "operationId": "inspect_api_v1_lab_inspect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InspectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read the logit lens and top MLP neurons for a prompt",
        "tags": [
          "lab"
        ]
      }
    },
    "/api/v1/lab/model": {
      "put": {
        "description": "Starts fetching and loading the named model, and answers once that has started. The switch replaces the model for every user of this Lab; poll the status to see it finish. Naming the model already resident, or already being switched to, changes nothing.",
        "operationId": "choose_model_api_v1_lab_model_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadModelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Switch the resident model",
        "tags": [
          "lab"
        ]
      }
    },
    "/api/v1/lab/status": {
      "get": {
        "operationId": "lab_status_api_v1_lab_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The resident model and any switch in progress",
        "tags": [
          "lab"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Process liveness"
      }
    },
    "/health/ready": {
      "get": {
        "description": "Ready to answer, whether or not a model is resident yet.\n\nGating this on the model looks right and is a trap: an unready pod\nis taken out of its Service, so after a failed load nobody could\nreach Lab to choose a model that works. Whether runs can be made is\nthe status route's `ready`, which the web app reads.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    }
  }
}
